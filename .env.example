PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:@localhost:3306/eureka_lms"
JWT_SECRET="run: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="run: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
JWT_REFRESH_EXPIRES_IN="30d"
OTP_EXPIRES_MINUTES=10
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@eureka-lms.com"
# Comma-separated allowed CORS origins (mobile app URL, web dashboard URL)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Firebase Cloud Messaging (FCM) - Provide either JSON path or env credentials
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# FIREBASE_PROJECT_ID="eureka-lms-app"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@eureka-lms-app.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

