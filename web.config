<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Node app is hosted by iisnode; iisnode.entry.cjs pins the CWD to the app root. -->
    <handlers>
      <add name="iisnode" path="iisnode.entry.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Every request goes to Express. Static files under /uploads are served by
             the app itself, so IIS must not short-circuit and expose .env,
             package.json, prisma/ or node_modules/ as static content. -->
        <rule name="EurekaNode" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="iisnode.entry.cjs" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      node_env="production"
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;iisnode.entry.cjs"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      maxLogFileSizeInKB="4096"
      maxTotalLogFileSizeInKB="65536"
      maxLogFiles="20"
      devErrorsEnabled="false"
      gracefulShutdownTimeout="10000"
      maxRequestBufferSize="4194304" />

    <!-- iisnode proxies the WebSocket upgrade to Socket.IO itself; the IIS
         WebSocket module must stay out of the way. -->
    <webSocket enabled="false" />

    <security>
      <requestFiltering>
        <!-- Lesson video uploader accepts up to 500 MB (src/config/multer.config.js). -->
        <requestLimits maxAllowedContentLength="524288000" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode-logs" />
          <add segment="prisma" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".orig" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
