    {
      "name": "Step 8: Notifications & Push Center",
      "description": "## 🔔 Phase 8: Notification Center & Push Alerts\n\n### 📱 Mobile UI Screens Covered:\n* `Mobile Push Notifications` (Firebase Cloud Messaging integration)\n* `In-App Notification Center Feed` (Filter by All / Unread)\n* `Notification Details Modal` (Auto-marks notification as read)\n* `Mark All as Read Action`\n\n### ⚙️ Automation Highlights:\n* Connects mobile FCM token to project `eureka-6366a` and auto-captures `{{notificationId}}`.",
      "item": [
        {
          "name": "8.1 Register Mobile FCM Device Token",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"fcm_device_sample_token_mobile_client_123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/notifications/fcm-token", "host": ["{{baseUrl}}"], "path": ["notifications", "fcm-token"] }
          }
        },
        {
          "name": "8.2 Get Notifications Feed (with Unread Count)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.notifications && res.data.notifications.length > 0) {",
                  "    pm.collectionVariables.set('notificationId', res.data.notifications[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications?filter=all",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [{ "key": "filter", "value": "all" }]
            }
          }
        },
        {
          "name": "8.3 Get Notification Details (Auto-Marks as Read)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notifications/{{notificationId}}", "host": ["{{baseUrl}}"], "path": ["notifications", "{{notificationId}}"] }
          }
        },
        {
          "name": "8.4 Mark All Notifications as Read",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["notifications", "read-all"] }
          }
        }
      ]
